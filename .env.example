GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
WEBHOOK_SECRET=your-random-secret-here

# AI 后端选择：openai（默认，使用 OpenAI 兼容接口）或 claude-cli（调用本机 claude 命令行）
AI_BACKEND=openai

# --- openai 后端配置（AI_BACKEND=openai 时必填）---
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=http://your-sub2api:8081/v1
OPENAI_MODEL=claude-sonnet-4-6

# --- claude-cli 后端配置（AI_BACKEND=claude-cli 时使用）---
# CLAUDE_BIN_PATH=claude          # claude 二进制路径，默认在 PATH 中查找
# CLAUDE_MODEL=claude-sonnet-4-6  # 可选，不填则使用 claude 默认模型

SERVER_PORT=8080
MAX_DIFF_BYTES=60000
API_KEY=your-chrome-extension-key
CORS_ORIGIN=http://git.ops.com.cn
