apiVersion: v1
kind: Secret
metadata:
  name: code-review-secret
  namespace: default
type: Opaque
stringData:
  GITLAB_TOKEN: "glpat-xxxxxxxxxxxxxxxxxxxx"   # GitLab Project Access Token (Reporter 角色)
  OPENAI_API_KEY: "sk-xxxxxxxxxxxxxxxxxxxx"    # OpenAI API Key
  WEBHOOK_SECRET: "your-random-secret-here"   # GitLab Webhook Secret Token

# 使用方式（推荐，不提交明文到 git）：
# kubectl create secret generic code-review-secret \
#   --from-literal=GITLAB_TOKEN=glpat-xxx \
#   --from-literal=OPENAI_API_KEY=sk-xxx \
#   --from-literal=WEBHOOK_SECRET=your-secret \
#   -n default
